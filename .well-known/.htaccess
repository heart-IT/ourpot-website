# The two domain-association files must reach Apple's and Google's verifiers as
# application/json over a direct 200 — the Apple one has no extension, so Apache
# would otherwise guess text/plain. release/well-known/README.md in the app repo
# says what each file binds.
<Files "apple-app-site-association">
  ForceType application/json
</Files>
<Files "assetlinks.json">
  ForceType application/json
</Files>
Options -Indexes
